APP_NAME="Ethernity DMs"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Endereço público do site e da API (o app iOS usa o mesmo). Local: http://localhost:8000. Produção: https://seu-dominio
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (único banco suportado)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ethernity
DB_USERNAME=ethernity
DB_PASSWORD=ethernity_secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@ethernity.local"
MAIL_FROM_NAME="${APP_NAME}"

# Ethernity — URLs & CORS (vazio = usa o APP_URL)
FRONTEND_URL=
CORS_ORIGINS=http://localhost:5173
# Proxy na frente do app que termina o HTTPS (balanceador, Cloudflare, Traefik): "*" ou a lista de IPs. Vazio = acesso direto
TRUSTED_PROXIES=

# Ethernity — Segurança & Criptografia (gere segredos fortes >= 64 chars em produção!)
JWT_SECRET=
JWT_TTL_SECONDS=86400
VAULT_MASTER_KEY=
VAULT_DISK=vault
UPLOADS_DISK=uploads
MAX_UPLOAD_BYTES=52428800

ADMIN_EMAILS=vameri@gmail.com
ENABLE_DEMO_LOGIN=0
ENABLE_PAYMENT_SIMULATION=0
RATE_LIMIT_ENABLED=0
# Documentação da API (/docs/api). Fica aberta só em APP_ENV=local; use 1 para abrir em outro ambiente
API_DOCS_PUBLIC=0
# Validade do token do app iOS, em segundos (padrão: 30 dias)
IOS_TOKEN_TTL_SECONDS=2592000

# Google OAuth & Google Photos Picker
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Vazio = APP_URL + /api/integrations/google-photos/callback
GOOGLE_PHOTOS_REDIRECT_URI=
# Chave AES-256-GCM de 32 bytes em base64 (ex.: php -r "echo base64_encode(random_bytes(32));")
GOOGLE_PHOTOS_TOKEN_ENCRYPTION_KEY=
GOOGLE_PHOTOS_STATE_TTL_SECONDS=600
GOOGLE_PHOTOS_MAX_FILE_SIZE_MB=50
GOOGLE_PHOTOS_MAX_ITEMS_PER_SESSION=50

# Mercado Pago
# Pagamentos reais (vazio = desligados). Ver seção 10 de DOCUMENTACAO.md
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
# MERCADO_PAGO_NOTIFICATION_URL=https://app.seudominio.com/api/subscriptions/webhook
# MERCADO_PAGO_BACK_URL=https://app.seudominio.com/
# MERCADO_PAGO_PIX_EXPIRATION_MINUTES=30
# MERCADO_PAGO_RENEWAL_GRACE_DAYS=10

# Armazenamento S3 / MinIO / Cloudflare R2 (opcional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Client ID público do Google usado pelo frontend (Google Photos no navegador). Não use VITE_API_URL: a API está na mesma origem (/api)
VITE_GOOGLE_CLIENT_ID=

# Responsável exibido em /privacidade e /termos (obrigatório antes de publicar o app OAuth do Google)
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_DOCUMENT=
PRIVACY_CONTACT_EMAIL=
